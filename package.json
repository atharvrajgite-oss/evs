    "recharts": "^2.12.3",
    "tailwind-merge": "^2.2.2",
    "three": "^0.162.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
